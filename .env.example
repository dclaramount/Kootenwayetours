# Copy this file to .env and adjust as needed for local development.

# Matches the postgres service in docker-compose.yml
DATABASE_URL="postgresql://kootenwaye:kootenwaye_dev@localhost:5432/kootenwaye?schema=public"

# Where uploaded media is written locally. In production this is the
# mount point of the 5Gi PersistentVolumeClaim (see planning-design).
UPLOAD_DIR="./data/uploads"

# Dev-only placeholder. Generate a real random value before deploying:
#   openssl rand -base64 32
SESSION_SECRET="dev-only-change-me"

NODE_ENV="development"
